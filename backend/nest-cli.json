{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "../package.json",
        "outDir": "../dist"
      },
      {
        "include": "../package-lock.json",
        "outDir": "../dist"
      }
    ],
    "watchAssets": false
  }
}
