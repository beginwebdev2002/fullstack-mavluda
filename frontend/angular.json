{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "",
  "projects": {
    "mavluda-beauty": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "./",
      "prefix": "app",
      "schematics": {
        "@schematics/angular:service": {
          "path": "src",
          "type": "service"
        },
        "@schematics/angular:component": {
          "path": "src",
          "type": "component"
        }
      },
      "i18n": {
        "sourceLocale": "en-US",
        "locales": {
          "ru": "src/locale/messages.ru.xlf",
          "tg": "src/locale/messages.tj.xlf"
        }
      },
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": {
              "base": "./dist",
              "browser": "."
            },
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.json",
            "styles": [ "node_modules/leaflet/dist/leaflet.css" ],
            "polyfills": [
              "@angular/localize/init"
            ],
            "assets": [
              {
                "glob": "**/*",
                "input": "node_modules/leaflet/dist/images",
                "output": "/images"
              },
              "./public"
            ]
          },
          "configurations": {
            "production": {
              "outputHashing": "all",
              "optimization": true,
              "sourceMap": false
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "fileReplacements": [
                {
                  "replace": "environments/environment.ts",
                  "with": "environments/environment.development.ts"
                }
              ]
            },
            "en": {
              "localize": [
                "en-US"
              ],
              "fileReplacements": [
                {
                  "replace": "environments/environment.ts",
                  "with": "environments/environment.en.ts"
                }
              ]
            },
            "ru": {
              "localize": [
                "ru"
              ],
              "fileReplacements": [
                {
                  "replace": "environments/environment.ts",
                  "with": "environments/environment.ru.ts"
                }
              ]
            },
            "tg": {
              "localize": [
                "tg"
              ],
              "fileReplacements": [
                {
                  "replace": "environments/environment.ts",
                  "with": "environments/environment.tg.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "port": 4200
          },
          "configurations": {
            "production": {
              "buildTarget": "mavluda-beauty:build:production"
            },
            "development": {
              "buildTarget": "mavluda-beauty:build:development"
            },
            "en": {
              "buildTarget": "mavluda-beauty:build:production,en"
            },
            "ru": {
              "buildTarget": "mavluda-beauty:build:production,ru"
            },
            "tg": {
              "buildTarget": "mavluda-beauty:build:production,tg"
            }
          },
          "defaultConfiguration": "production"
        }
      }
    }
  },
  "cli": {
    "analytics": "6b13a253-7739-43f5-b850-3f21dd45a03d"
  }
}